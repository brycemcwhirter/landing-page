---
import Boxes from '../components/Boxes.svelte'
import SocialProfiles from '../components/SocialProfiles.astro'
import Navigation from '../components/Navigation.astro'
import '../styles/app.css'
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <title>Bryce McWhirter</title>
    </head>
    <body class="gradient-bg text-primaryWhite min-h-screen flex flex-col">
        <Navigation avatarUrl="/profilePicture.png" name="Bryce McWhirter" />
        
        <main class="flex-grow">
            <!-- Your main content goes here -->
        </main>

        <footer class="w-full py-8 bg-primaryBlue/20 backdrop-blur-sm mt-auto">
            <div class="container mx-auto px-4 flex justify-center items-center">
                <SocialProfiles />
            </div>
        </footer>
    </body>
</html>
