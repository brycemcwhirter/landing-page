---
import Navigation from '../components/Navigation.astro';
import SocialProfiles from '../components/SocialProfiles.astro';
import Boxes from '../components/Boxes.svelte';

interface Props {
    title: string;
    description: string;
    boxes: Array<{
        title: string;
        description: string;
        imgLink: string;
        altDesc: string;
        link: string;
    }>;
}

const { title, description, boxes } = Astro.props;
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <title>{title} | Bryce McWhirter</title>
    </head>
    <body class="gradient-bg text-primaryWhite min-h-screen flex flex-col">
        <Navigation client:load avatarUrl="/profilePicture.png" name="Bryce McWhirter" />
        
        <main class="flex-grow container">
            <div class="p-8 ">
                <!-- Content Section -->
                <div class="space-y-4">
                    <h1 class="text-4xl font-bold">{title}</h1>
                    <p class="text-lg text-primaryWhite/80">{description}</p>
                </div>
                
                <!-- Boxes Section -->
                <Boxes client:load boxes={boxes} />

            </div>
        </main>

        <footer class="w-full py-8  backdrop-blur-sm mt-auto">
            <div class="container mx-auto px-4 flex justify-center items-center">
                <SocialProfiles client:load />
            </div>
        </footer>
    </body>
</html>